@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix o: <http://omeka.org/s/vocabs/o#> .
@prefix provenance: <https://omeka-s-t1.berlin-university-collections.de/ns/provenance#> .

<https://omeka-s-t1.berlin-university-collections.de/ns/provenance#> a owl:Ontology ;
    dcterms:title "Provenance Ontology" ;
    dcterms:description "Ontology for provenance related documentation" .

### work fields

provenance:workTitle a rdf:Property ;
    rdfs:label "Work Title" ;
    rdfs:comment "Title of the work" ;
    rdfs:domain o:Resource .

provenance:workArtist a rdf:Property ;
    rdfs:label "Work Artist" ;
    rdfs:comment "Artist of the work" ;
    rdfs:domain o:Resource .

provenance:workDimensions a rdf:Property ;
    rdfs:label "Work Dimensions" ;
    rdfs:comment "Dimensions of the work" ;
    rdfs:domain o:Resource .

provenance:workSignature a rdf:Property ;
    rdfs:label "Work Signature" ;
    rdfs:comment "Signature on the work" ;
    rdfs:domain o:Resource .

provenance:workDateMaterialsTechnique a rdf:Property ;
    rdfs:label "Work Materials and Technique" ;
    rdfs:comment "Date of the work" ;
    rdfs:domain o:Resource .

provenance:workDateDisplay a rdf:Property ;
    rdfs:label "Work Date Display" ;
    rdfs:comment "Date of the work" ;
    rdfs:domain o:Resource .

provenance:workDate a rdf:Property ;
    rdfs:label "Work Date" ;
    rdfs:comment "Date of the work" ;
    rdfs:domain o:Resource .

provenance:workDateEarliest a rdf:Property ;
    rdfs:label "Work Date Earliest" ;
    rdfs:comment "Date of the work" ;
    rdfs:domain o:Resource .

provenance:workDateLatest a rdf:Property ;
    rdfs:label "Work Date Latest" ;
    rdfs:comment "Date of the work" ;
    rdfs:domain o:Resource .

provenance:workLocation a rdf:Property ;
    rdfs:label "Work Location" ;
    rdfs:comment "Location of the work" ;
    rdfs:domain o:Resource .

provenance:workLostArtId a rdf:Property ;
    rdfs:label "Work Lost Art Id" ;
    rdfs:comment "Lost Art id of the work" ;
    rdfs:domain o:Resource .


### information fields

provenance:informationSource a rdf:Property ;
    rdfs:label "Source of information" ;
    rdfs:comment "Source item for the information" ;
    rdfs:domain o:Resource .

### source fields

provenance:sourceReference a rdf:Property ;
    rdfs:label "Reference of source" ;
    rdfs:comment "Bibliographic reference of the source" ;
    rdfs:domain o:Resource .

provenance:sourceOnlineResource a rdf:Property ;
    rdfs:label "Online resource of source" ;
    rdfs:comment "URL of the source" ;
    rdfs:domain o:Resource .

provenance:sourceTranscript a rdf:Property ;
    rdfs:label "Transcription of text" ;
    rdfs:comment "Transcript of relevant passages from the source" ;
    rdfs:domain o:Resource .

### provenance fields

provenance:currentOwner a rdf:Property ;
    rdfs:label "Current Owner" ;
    rdfs:comment "Owner at a given station of the provenance chain" ;
    rdfs:domain o:Resource .

provenance:previousOwner a rdf:Property ;
    rdfs:label "Previous Owner" ;
    rdfs:comment "Owner immediately privious of a given station of the provenance chain" ;
    rdfs:domain o:Resource .

### source fields

provenance:sourceReference a rdf:Property ;
    rdfs:label "Reference of source" ;
    rdfs:comment "Bibliographic reference of the source" ;
    rdfs:domain o:Resource .